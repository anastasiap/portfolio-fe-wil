{
  "name": "wheeloflife",
  "version": "3.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "watch": "ng build --watch --configuration development",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "prebuild:ssr": "node scripts/generate-sitemap.mjs",
    "preprerender": "node scripts/generate-sitemap.mjs",
    "build": "ng build --configuration production",
    "build:analyze": "ng build --configuration production --stats-json && npx webpack-bundle-analyzer dist/wheeloflife/browser/stats.json",
    "serve:build": "node scripts/local-static-proxy.js",
    "dev:ssr": "ng run wheeloflife:serve-ssr",
    "serve:ssr": "node dist/wheeloflife/server/main.js",
    "build:ssr": "ng build --configuration=production && ng run wheeloflife:server:production && npm run sentry:sourcemaps",
    "prerender": "ng run wheeloflife:prerender:production",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e-guest": "playwright test --project=guest-chromium",
    "e2e-auth": "playwright test --project=authenticated-chromium",
    "build:ssr:prerender:test": "ng build --configuration=production && ng run wheeloflife:server:production && ng run wheeloflife:prerender:production",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.10",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.10",
    "@angular/compiler": "^17.3.10",
    "@angular/core": "^17.3.10",
    "@angular/flex-layout": "^15.0.0-beta.42",
    "@angular/forms": "^17.3.10",
    "@angular/material": "^17.3.10",
    "@angular/platform-browser": "^17.3.10",
    "@angular/platform-browser-dynamic": "^17.3.10",
    "@angular/platform-server": "^17.3.10",
    "@angular/router": "^17.3.10",
    "@angular/ssr": "^17.3.10",
    "@colsen1991/ngx-translate-extract-marker": "^3.0.1",
    "@ngrx/effects": "^17.2.0",
    "@ngrx/store": "^17.2.0",
    "@ngrx/store-devtools": "^17.2.0",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "@sentry/angular": "^10.47.0",
    "@sentry/cli": "^2.58.5",
    "chart.js": "^3.4.0 || ^4.0.0",
    "dom-to-image": "^2.6.0",
    "marked": "^12.0.2",
    "ng2-charts": "6.0.1",
    "ngx-color": "^9.0.0",
    "ngx-markdown": "^17.2.1",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.10",
    "@angular/cli": "~17.3.10",
    "@angular/compiler-cli": "^17.3.10",
    "@ngrx/schematics": "^20.0.1",
    "@playwright/test": "^1.62.0",
    "@types/dom-to-image": "^2.6.7",
    "@types/jasmine": "~4.3.0",
    "angular-eslint": "21.0.1",
    "browser-sync": "^3.0.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "jasmine-core": "~4.5.0",
    "jasmine-snapshot": "^1.8.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "lint-staged": "^15.5.2",
    "prettier": "^2.8.4",
    "typescript": "~5.3.3",
    "typescript-eslint": "8.46.4",
    "webpack-bundle-analyzer": "^5.2.0"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,json,md}": "prettier --write"
  }
}
